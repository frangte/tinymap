# nginx site for server.tinymap.live, rendered and installed by scripts/deploy.sh. Edit this template, not the copy on the server.
# nginx serves the built game; /ws (WebSocket) and /healthz go to the Go server on 127.0.0.1:8087.

# Connection header for WebSocket upgrades. The variable name is unique so it can't clash with another site on this nginx.
map $http_upgrade $sg_tinymap_connection {
    default upgrade;
    ''      close;
}

upstream sg_tinymap_server {
    server 127.0.0.1:8087;
}

server {
    listen 80;
    listen [::]:80;
    server_name server.tinymap.live;

    # Let's Encrypt webroot challenge (first certificate and renewals)
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # `listen ... http2` works on every nginx; nginx 1.25.1+ only warns that it is deprecated
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name server.tinymap.live;

    ssl_certificate     /etc/letsencrypt/live/server.tinymap.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server.tinymap.live/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:sg_tinymap_ssl:5m;

    root {{APP_DIR}}/current/dist;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml model/gltf-binary application/octet-stream;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # multiplayer socket
    location = /ws {
        proxy_pass http://sg_tinymap_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sg_tinymap_connection;
        # keep the public host: the server's origin check compares it with the page's Origin
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # the server pings every 54 s; the default 60 s timeout is too close
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /healthz {
        proxy_pass http://sg_tinymap_server;
        proxy_set_header Host $host;
    }

    # Vite puts a content hash in these names: cache forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # index.html and models/ are revalidated, so a deploy shows up on the next load
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri $uri/ =404;
    }
}
