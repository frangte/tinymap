{
  "name": "saigon-noir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && go run ./cmd/server",
    "server:test": "cd server && go vet ./... && go test -race ./...",
    "nav:sync": "cp public/models/saigon_q1_nav.png public/models/saigon_q1_nav.json server/content/nav/",
    "deploy": "scripts/deploy.sh",
    "deploy:check": "scripts/deploy.sh check",
    "deploy:rollback": "scripts/deploy.sh rollback",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/inline.mjs"
  },
  "dependencies": {
    "lil-gui": "0.19.2",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "typescript": "5.4.5",
    "vite": "5.2.11"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
