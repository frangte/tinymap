          "text": {
            "vi": "Hỏi đường người Sài Gòn (Cẩm nang); không ai tới thì hỏi Chú Sáu",
            "en": "Ask a Saigonese the way (Guidebook); if nobody comes, ask Chú Sáu"
          }
        }
      ],
      "rewards": {
        "stamps": [
          "hoi_duong"
        ]
